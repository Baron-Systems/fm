x-customizable-image: &customizable_image
  image: {{ ERPNEXT_IMAGE }}
  restart: unless-stopped

x-depends-on-configurator: &depends_on_configurator
  depends_on:
    configurator:
      condition: service_completed_successfully

x-bench-volumes: &bench_volumes
  - sites:/home/frappe/frappe-bench/sites
  - logs:/home/frappe/frappe-bench/logs
  - assets:/home/frappe/frappe-bench/assets

x-bench-env: &bench_env
  DB_HOST: db
  DB_PORT: "3306"
  REDIS_CACHE: redis://redis:6379
  REDIS_QUEUE: redis://redis:6379
  REDIS_SOCKETIO: redis://redis:6379
  SOCKETIO_PORT: 9000
  SHELL: /bin/bash
  TERM: xterm

services:
  # Single container approach - everything in one container
  frappe:
    <<: *customizable_image
    container_name: {{ NAME }}-frappe
    platform: linux/amd64
    environment:
      <<: *bench_env
    volumes: *bench_volumes
    # Simple and direct approach
    command: ["bash", "-c", "cd /home/frappe/frappe-bench && echo 'Waiting for database and Redis...' && while ! nc -z db 3306 2>/dev/null; do echo 'Database not ready, waiting...' && sleep 5; done && while ! nc -z redis 6379 2>/dev/null; do echo 'Redis not ready, waiting...' && sleep 5; done && echo 'Dependencies ready, starting Frappe...' && exec bench start"]
    depends_on:
      - db
      - redis
    restart: unless-stopped
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.{{ NAME }}.rule=Host(`{{ DOMAIN }}`)"
      - "traefik.http.routers.{{ NAME }}.entrypoints=websecure"
      - "traefik.http.routers.{{ NAME }}.tls.certresolver={{ CERTRESOLVER }}"
      - "traefik.http.services.{{ NAME }}.loadbalancer.server.port=8000"

  db:
    image: {{ MARIADB_IMAGE }}
    container_name: {{ NAME }}-db
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      - --skip-character-set-client-handshake
      - --skip-innodb-read-only-compressed
    environment:
      MYSQL_ROOT_PASSWORD: "{{ DB_ROOT_PASSWORD }}"
      MARIADB_ROOT_PASSWORD: "{{ DB_ROOT_PASSWORD }}"
    volumes:
      - db-data:/var/lib/mysql
    restart: unless-stopped

  redis:
    image: {{ REDIS_IMAGE }}
    container_name: {{ NAME }}-redis
    restart: unless-stopped

volumes:
  db-data:
  sites:
  logs:
  assets:
