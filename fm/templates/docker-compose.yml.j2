x-customizable-image: &customizable_image
  image: {{ ERPNEXT_IMAGE }}
  restart: unless-stopped

x-depends-on-configurator: &depends_on_configurator
  depends_on:
    configurator:
      condition: service_completed_successfully

x-bench-volumes: &bench_volumes
  - sites:/home/frappe/frappe-bench/sites
  - logs:/home/frappe/frappe-bench/logs
  - assets:/home/frappe/frappe-bench/assets

x-bench-env: &bench_env
  DB_HOST: db
  DB_PORT: "3306"
  REDIS_CACHE: redis://redis:6379
  REDIS_QUEUE: redis://redis:6379
  REDIS_SOCKETIO: redis://redis:6379
  SOCKETIO_PORT: 9000
  SHELL: /bin/bash
  TERM: xterm

services:
  configurator:
    <<: *customizable_image
    container_name: {{ NAME }}-configurator
    platform: linux/amd64
    entrypoint: [bash, -c]
    command:
      - >
        ls -1 apps > sites/apps.txt;
        bench set-config -g db_host $$DB_HOST;
        bench set-config -gp db_port $$DB_PORT;
        bench set-config -g redis_cache "redis://$$REDIS_CACHE";
        bench set-config -g redis_queue "redis://$$REDIS_QUEUE";
        bench set-config -g redis_socketio "redis://$$REDIS_QUEUE";
        bench set-config -gp socketio_port $$SOCKETIO_PORT;
        bench set-config -g chromium_path /usr/bin/chromium-headless-shell;
    environment:
      <<: *bench_env
    volumes: *bench_volumes
    depends_on: {}
    restart: on-failure

  db:
    image: {{ MARIADB_IMAGE }}
    container_name: {{ NAME }}-db
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      - --skip-character-set-client-handshake
      - --skip-innodb-read-only-compressed
    environment:
      MYSQL_ROOT_PASSWORD: "{{ DB_ROOT_PASSWORD }}"
      MARIADB_ROOT_PASSWORD: "{{ DB_ROOT_PASSWORD }}"
    volumes:
      - db-data:/var/lib/mysql
    restart: unless-stopped

  redis:
    image: {{ REDIS_IMAGE }}
    container_name: {{ NAME }}-redis
    restart: unless-stopped

  # Single Frappe Container (like rtCamp)
  frappe:
    <<: [*depends_on_configurator, *customizable_image]
    container_name: {{ NAME }}-frappe
    platform: linux/amd64
    environment:
      <<: *bench_env
    volumes: *bench_volumes
    # Use supervisord to manage all processes
    command: >
      bash -c "
      echo '[unix_http_server]' > /home/frappe/frappe-bench/supervisord.conf
      echo 'file=/tmp/supervisor.sock' >> /home/frappe/frappe-bench/supervisord.conf
      echo '' >> /home/frappe/frappe-bench/supervisord.conf
      echo '[supervisord]' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'nodaemon=true' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'logfile=/home/frappe/frappe-bench/logs/supervisord.log' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'pidfile=/home/frappe/frappe-bench/logs/supervisord.pid' >> /home/frappe/frappe-bench/supervisord.conf
      echo '' >> /home/frappe/frappe-bench/supervisord.conf
      echo '[rpcinterface:supervisor]' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface' >> /home/frappe/frappe-bench/supervisord.conf
      echo '' >> /home/frappe/frappe-bench/supervisord.conf
      echo '[supervisorctl]' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'serverurl=unix:///tmp/supervisor.sock' >> /home/frappe/frappe-bench/supervisord.conf
      echo '' >> /home/frappe/frappe-bench/supervisord.conf
      echo '[program:frappe-backend]' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'command=bench serve --port=8000 --no-reload' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'directory=/home/frappe/frappe-bench' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'user=frappe' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'autostart=true' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'autorestart=true' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'stdout_logfile=/home/frappe/frappe-bench/logs/backend.log' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'stderr_logfile=/home/frappe/frappe-bench/logs/backend.error.log' >> /home/frappe/frappe-bench/supervisord.conf
      echo '' >> /home/frappe/frappe-bench/supervisord.conf
      echo '[program:frappe-socketio]' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'command=node apps/frappe/socketio.js' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'directory=/home/frappe/frappe-bench' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'user=frappe' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'autostart=true' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'autorestart=true' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'stdout_logfile=/home/frappe/frappe-bench/logs/socketio.log' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'stderr_logfile=/home/frappe/frappe-bench/logs/socketio.error.log' >> /home/frappe/frappe-bench/supervisord.conf
      echo '' >> /home/frappe/frappe-bench/supervisord.conf
      echo '[program:frappe-worker-short]' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'command=bench worker --queue short,default' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'directory=/home/frappe/frappe-bench' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'user=frappe' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'autostart=true' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'autorestart=true' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'stdout_logfile=/home/frappe/frappe-bench/logs/worker-short.log' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'stderr_logfile=/home/frappe/frappe-bench/logs/worker-short.error.log' >> /home/frappe/frappe-bench/supervisord.conf
      echo '' >> /home/frappe/frappe-bench/supervisord.conf
      echo '[program:frappe-worker-long]' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'command=bench worker --queue long,default,short' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'directory=/home/frappe/frappe-bench' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'user=frappe' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'autostart=true' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'autorestart=true' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'stdout_logfile=/home/frappe/frappe-bench/logs/worker-long.log' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'stderr_logfile=/home/frappe/frappe-bench/logs/worker-long.error.log' >> /home/frappe/frappe-bench/supervisord.conf
      echo '' >> /home/frappe/frappe-bench/supervisord.conf
      echo '[program:frappe-scheduler]' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'command=bench schedule' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'directory=/home/frappe/frappe-bench' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'user=frappe' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'autostart=true' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'autorestart=true' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'stdout_logfile=/home/frappe/frappe-bench/logs/scheduler.log' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'stderr_logfile=/home/frappe/frappe-bench/logs/scheduler.error.log' >> /home/frappe/frappe-bench/supervisord.conf
      echo '' >> /home/frappe/frappe-bench/supervisord.conf
      echo '[program:nginx]' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'command=nginx-entrypoint.sh' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'user=root' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'autostart=true' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'autorestart=true' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'stdout_logfile=/home/frappe/frappe-bench/logs/nginx.log' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'stderr_logfile=/home/frappe/frappe-bench/logs/nginx.error.log' >> /home/frappe/frappe-bench/supervisord.conf
      echo '' >> /home/frappe/frappe-bench/supervisord.conf
      echo '[program:nginx-health]' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'command=bash -c \"while ! curl -f http://localhost:80/health; do sleep 2; done\"' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'user=frappe' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'autostart=false' >> /home/frappe/frappe-bench/supervisord.conf
      echo 'startsecs=0' >> /home/frappe/frappe-bench/supervisord.conf
      
      # Start supervisord
      exec supervisord -c /home/frappe/frappe-bench/supervisord.conf
      "
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.{{ NAME }}.rule=Host(`{{ DOMAIN }}`)"
      - "traefik.http.routers.{{ NAME }}.entrypoints=websecure"
      - "traefik.http.routers.{{ NAME }}.tls.certresolver={{ CERTRESOLVER }}"
      - "traefik.http.services.{{ NAME }}.loadbalancer.server.port=80"

volumes:
  db-data:
  sites:
  logs:
  assets:
