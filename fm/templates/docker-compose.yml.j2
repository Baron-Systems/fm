x-customizable-image: &customizable_image
  image: {{ ERPNEXT_IMAGE }}
  restart: unless-stopped

x-depends-on-configurator: &depends_on_configurator
  depends_on:
    configurator:
      condition: service_completed_successfully

x-bench-volumes: &bench_volumes
  - sites:/home/frappe/frappe-bench/sites
  - logs:/home/frappe/frappe-bench/logs
  - assets:/home/frappe/frappe-bench/assets

x-bench-env: &bench_env
  DB_HOST: db
  DB_PORT: "3306"
  REDIS_CACHE: redis://redis:6379
  REDIS_QUEUE: redis://redis:6379
  REDIS_SOCKETIO: redis://redis:6379
  SOCKETIO_PORT: 9000
  SHELL: /bin/bash
  TERM: xterm

services:
  configurator:
    <<: *customizable_image
    container_name: {{ NAME }}-configurator
    platform: linux/amd64
    entrypoint: [bash, -c]
    command:
      - >
        ls -1 apps > sites/apps.txt;
        bench set-config -g db_host $$DB_HOST;
        bench set-config -gp db_port $$DB_PORT;
        bench set-config -g redis_cache "redis://$$REDIS_CACHE";
        bench set-config -g redis_queue "redis://$$REDIS_QUEUE";
        bench set-config -g redis_socketio "redis://$$REDIS_QUEUE";
        bench set-config -gp socketio_port $$SOCKETIO_PORT;
        bench set-config -g chromium_path /usr/bin/chromium-headless-shell;
    environment:
      <<: *bench_env
    volumes: *bench_volumes
    depends_on: {}
    restart: on-failure

  db:
    image: {{ MARIADB_IMAGE }}
    container_name: {{ NAME }}-db
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      - --skip-character-set-client-handshake
      - --skip-innodb-read-only-compressed
    environment:
      MYSQL_ROOT_PASSWORD: "{{ DB_ROOT_PASSWORD }}"
      MARIADB_ROOT_PASSWORD: "{{ DB_ROOT_PASSWORD }}"
    volumes:
      - db-data:/var/lib/mysql
    restart: unless-stopped

  redis:
    image: {{ REDIS_IMAGE }}
    container_name: {{ NAME }}-redis
    restart: unless-stopped

  # Backend service - Frappe application server
  backend:
    <<: [*depends_on_configurator, *customizable_image]
    container_name: {{ NAME }}-backend
    platform: linux/amd64
    environment:
      <<: *bench_env
    volumes: *bench_volumes
    command: bench serve --port=8000 --no-reload
    restart: unless-stopped

  # Frontend service - Nginx reverse proxy
  frontend:
    <<: *customizable_image
    container_name: {{ NAME }}-frontend
    platform: linux/amd64
    depends_on:
      - backend
    environment:
      <<: *bench_env
      BACKEND: backend:8000
      FRAPPE_SITE_NAME_HEADER: "{{ DOMAIN }}"
      SOCKETIO: websocket:9000
      UPSTREAM_REAL_IP_ADDRESS: 127.0.0.1
      UPSTREAM_REAL_IP_HEADER: X-Forwarded-For
      UPSTREAM_REAL_IP_RECURSIVE: "off"
      PROXY_READ_TIMEOUT: 120
      CLIENT_MAX_BODY_SIZE: 50m
    volumes: *bench_volumes
    command: nginx-entrypoint.sh
    restart: unless-stopped
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.{{ NAME }}.rule=Host(`{{ DOMAIN }}`)"
      - "traefik.http.routers.{{ NAME }}.entrypoints=websecure"
      - "traefik.http.routers.{{ NAME }}.tls.certresolver={{ CERTRESOLVER }}"
      - "traefik.http.services.{{ NAME }}.loadbalancer.server.port=80"

  # WebSocket service
  websocket:
    <<: [*depends_on_configurator, *customizable_image]
    container_name: {{ NAME }}-websocket
    platform: linux/amd64
    environment:
      <<: *bench_env
      FRAPPE_REDIS_CACHE: redis://redis:6379
      FRAPPE_REDIS_QUEUE: redis://redis:6379
    volumes: *bench_volumes
    command: node apps/frappe/socketio.js
    restart: unless-stopped

  # Queue workers
  queue-short:
    <<: [*depends_on_configurator, *customizable_image]
    container_name: {{ NAME }}-queue-short
    platform: linux/amd64
    environment:
      <<: *bench_env
      FRAPPE_REDIS_CACHE: redis://redis:6379
      FRAPPE_REDIS_QUEUE: redis://redis:6379
    volumes: *bench_volumes
    command: bench worker --queue short,default
    restart: unless-stopped

  queue-long:
    <<: [*depends_on_configurator, *customizable_image]
    container_name: {{ NAME }}-queue-long
    platform: linux/amd64
    environment:
      <<: *bench_env
      FRAPPE_REDIS_CACHE: redis://redis:6379
      FRAPPE_REDIS_QUEUE: redis://redis:6379
    volumes: *bench_volumes
    command: bench worker --queue long,default,short
    restart: unless-stopped

  # Scheduler
  scheduler:
    <<: [*depends_on_configurator, *customizable_image]
    container_name: {{ NAME }}-scheduler
    platform: linux/amd64
    environment:
      <<: *bench_env
      FRAPPE_REDIS_CACHE: redis://redis:6379
      FRAPPE_REDIS_QUEUE: redis://redis:6379
    volumes: *bench_volumes
    command: bench schedule
    restart: unless-stopped

volumes:
  db-data:
  sites:
  logs:
  assets:
